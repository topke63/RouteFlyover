{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Route Flyover on Cloudflare Workers: the app is static assets; the only server code is the
  // shared map-tile counter in worker/index.js, which gets just the /api/* requests.
  // MP4 conversion falls back to the browser here; see README "Running Route Flyover".
  "name": "route-flyover",
  "compatibility_date": "2026-09-15",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Tiles used per month (see migrations/). Create your own with
  // `npx wrangler d1 create route-flyover-usage` and put its id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "route-flyover-usage",
      "database_id": "675d563a-3575-4fab-ac36-5b2d9ed5dddc",
      "migrations_dir": "migrations"
    }
  ],
  // https://route-flyover.topke63.workers.dev — public. That's fine only when built with an
  // ArcGIS API key (VITE_ARCGIS_KEY in .env.local); without one, put Cloudflare Access in front
  // of it (README "Hosting it online"), since the public Esri tile servers are for personal use.
  "workers_dev": true,
  "preview_urls": false
}
